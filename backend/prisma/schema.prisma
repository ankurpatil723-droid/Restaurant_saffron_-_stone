generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env(postgresql://postgres.tnfgvgzlppgutjeweima:Ankur@2007AP@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres)
 
}

model Todo {
  id          BigInt   @id @default(autoincrement())
  name        String
  is_complete Boolean  @default(false)
  inserted_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("todos")
}

model Order {
  id             BigInt   @id @default(autoincrement())
  order_id       String   @unique
  customer_name  String
  phone          String
  order_type     String
  address        String?
  notes          String?
  items          Json     @default("[]")
  subtotal       Decimal  @db.Decimal(10, 2)
  discount       Decimal? @default(0) @db.Decimal(10, 2)
  tax            Decimal  @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  payment_status String?  @default("pending_verification")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("orders")
}
